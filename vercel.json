{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "aceit-spikers-1.html",
      "use": "@vercel/static"
    },
    {
      "src": "banner1.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "banner2.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "spikers-logo.png",
      "use": "@vercel/static"
    },
    {
      "src": "volleyball-loader.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/banner1.jpg",
      "dest": "/banner1.jpg"
    },
    {
      "src": "/banner2.jpg",
      "dest": "/banner2.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "aceit-spikers-1.html"
    }
  ],
  "headers": [
    {
      "source": "/api/db(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=15, s-maxage=60, stale-while-revalidate=300" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    },
    {
      "source": "/api/clubs(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=30, s-maxage=120, stale-while-revalidate=300" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    },
    {
      "source": "/api/v2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=30, s-maxage=120, stale-while-revalidate=300" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
