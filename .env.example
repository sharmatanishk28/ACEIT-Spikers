# MongoDB Atlas Connection String
# Copy this file to .env and fill in your real values
# Get the connection string from: MongoDB Atlas Dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spikers?retryWrites=true&w=majority&appName=Cluster0

# Admin Security PIN (defaults to 2026 if unset)
ADMIN_PIN=2026

# Node Environment (development or production)
NODE_ENV=production

# Port (optional, defaults to 3000)
PORT=3000
