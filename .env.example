# MongoDB Atlas Connection String
# Copy this file to .env and fill in your real values
# Get the connection string from: MongoDB Atlas Dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spikers?retryWrites=true&w=majority&appName=Cluster0

# Admin Security PIN (defaults to 2026 if unset)
ADMIN_PIN=2026

# Required in production. Use a long random value shared by all Vercel functions.
JWT_SECRET=replace-with-a-long-random-secret

# Optional comma-separated browser origins when the frontend is hosted separately.
CORS_ORIGINS=https://your-production-domain.vercel.app

# Node Environment (development or production)
NODE_ENV=production

# Permanent image/object storage (required for all admin and profile uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Port (optional, defaults to 3000)
PORT=3000
